# Provider: "xai" (Grok) or "openai" (gpt-image-1). Default "xai".
PROVIDER=xai

# xAI key — needed if PROVIDER=xai
XAI_API_KEY=

# OpenAI key — needed if PROVIDER=openai (fallback if Grok output quality disappoints)
OPENAI_API_KEY=

# Port for the local server
PORT=4321

# Aspect ratio passed to Grok. 4:5 isn't native — we render at 3:4 and center-crop to 4:5.
# Valid Grok values: 1:1, 16:9, 9:16, 4:3, 3:4, 3:2, 2:3, 2:1, 1:2, 19.5:9, 9:19.5, 20:9, 9:20, auto
GROK_ASPECT_RATIO=3:4
GROK_RESOLUTION=2k
